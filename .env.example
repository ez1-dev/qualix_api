# =============================================================================
# QUALIFX ERP API - EXEMPLO DE .env (sem segredos)
# Copie para .env e preencha os valores reais. NÃO commite o .env.
# =============================================================================

SECRET_KEY=ERP_SECRET
ALGORITHM=HS256

SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=172.16.137.100
SQL_DATABASE=sapiens
SQL_USER=sapiens
SQL_PASSWORD=COLOQUE_A_SENHA_AQUI
EMPRESA_PADRAO=1

# Supabase / Lovable (use a chave de backend: service_role / secret key completa)
LOVABLE_DB_URL=https://SEU-PROJETO.supabase.co
LOVABLE_DB_KEY=COLOQUE_A_CHAVE_AQUI

LOVABLE_TABLE_LOTS=lots
LOVABLE_TABLE_DOCUMENTS=documents
LOVABLE_TABLE_CERTIFICATES_AI=certificates_ai
LOVABLE_TABLE_ANALYSIS_JOBS=analysis_jobs
LOVABLE_TABLE_DOCUMENT_COMMENTS=document_comments

APP_ADMIN_PASSWORD=troque_aqui
APP_RENATO_PASSWORD=troque_aqui
APP_TRIBUTOS_PASSWORD=troque_aqui

UPLOAD_DIR=uploads
FINAL_SERVER_BASE_PATH=\\Ezortea-srvseni\sgq\CERTIFQ
USE_MULTIEMPRESA_LOT_KEY=false

# Sincronizacao automatica dos lotes (APScheduler)
SYNC_SCHEDULE_ENABLED=true
SYNC_HOUR=20
SYNC_MINUTE=0
SYNC_TIMEZONE=America/Sao_Paulo
